{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vault",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": { "enabled": true },
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vault-db",
			"database_id": "c7c70fcc-cd2d-42e2-9250-bf045f5b29b6",
			"migrations_dir": "migrations"
		}
	],
	"routes": [{ "pattern": "vault.suchangv.com", "custom_domain": true }],
	"vars": {
		"ACCESS_TEAM_DOMAIN": "suchangv.cloudflareaccess.com",
		"ACCESS_AUD": "149e46306afc0148504a20a2a391e7c26206eac55fecfd114eb683967ff59ead",
		"ALLOWED_EMAILS": "suchangv@gmail.com",
		"DEV_AUTH_BYPASS": "false"
	}
}
