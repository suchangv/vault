{
	"name": "cf-vault",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Zero-knowledge password manager on Cloudflare Workers, fronted by Cloudflare Access.",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"check": "tsc --noEmit",
		"db:local": "wrangler d1 migrations apply vault-db --local",
		"db:remote": "wrangler d1 migrations apply vault-db --remote",
		"tail": "wrangler tail"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261031.1",
		"typescript": "^5.6.3",
		"wrangler": "^4.164.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261117.1": true
	}
}
